#!/bin/bash
# ═══════════════════════════════════════════
# onMyWay - Start script
# Backend (3000) + Web (3004) + PostgreSQL (5432) + Redis (6379)
# ═══════════════════════════════════════════

echo ""
echo "🗺️ onMyWay — Starting..."
echo ""

# Kill existing processes
for port in 3000 3004; do
  pid=$(lsof -ti:$port 2>/dev/null)
  if [ -n "$pid" ]; then
    kill -9 $pid 2>/dev/null
    echo "   🔪 Killed process on port $port"
  fi
done

sleep 1

# ─── Check .env ──────────────────────────
if [ -f backend/.env ]; then
  echo "   ✅ .env configured"
else
  echo "   ⚠️  backend/.env missing — copy from .env.example"
  exit 1
fi

# ─── Check Docker ────────────────────────
if docker info > /dev/null 2>&1; then
  echo "   ✅ Docker running"
else
  echo "   🔄 Starting Colima..."
  colima start 2>/dev/null
  sleep 5
  if docker info > /dev/null 2>&1; then
    echo "   ✅ Colima started"
  else
    echo "   ❌ Docker not available — PostgreSQL needs Docker"
    exit 1
  fi
fi

# ─── Check port 5432 conflict ────────────
other_pg=$(docker ps --format '{{.Names}}' 2>/dev/null | grep -v onmyway-postgres | grep -i postgres)
if [ -n "$other_pg" ]; then
  echo "   🔄 Stopping conflicting PostgreSQL: $other_pg"
  docker stop $other_pg 2>/dev/null
  sleep 1
fi

# ─── PostgreSQL + PostGIS ────────────────
if docker ps 2>/dev/null | grep -q onmyway-postgres; then
  echo "   ✅ PostgreSQL (onmyway-postgres) running"
else
  echo "   🔄 Starting PostgreSQL + PostGIS..."
  cd backend && docker-compose up -d 2>/dev/null && cd ..
  sleep 3
  if docker ps 2>/dev/null | grep -q onmyway-postgres; then
    echo "   ✅ PostgreSQL started"
  else
    echo "   ❌ PostgreSQL failed — check backend/docker-compose.yml"
    exit 1
  fi
fi

# ─── OSRM ────────────────────────────────
if docker ps 2>/dev/null | grep -q osrm; then
  echo "   ✅ OSRM container running"
else
  echo "   ⚠️  OSRM not running (routing/ETA may not work)"
fi

echo ""
echo "   Starting backend (3000) + web (3004)..."
echo ""

# Start both
cd backend && npm run start:dev &
cd web && npm run dev &
wait
